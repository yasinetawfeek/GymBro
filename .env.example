# GymBro Environment Configuration
# Copy this file to .env and update the values as needed

# Database Configuration
DB_USER=gymbro
DB_PASSWORD=gymbro123
DB_NAME=gymbro_db
DB_HOST=localhost
DB_PORT=5432

# Django Configuration
SECRET_KEY=your-super-secret-key-here-change-this-in-production
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Redis Configuration
REDIS_URL=redis://localhost:6379/0

# AI Service Configuration
AI_SERVICE_URL=http://localhost:8001
BACKEND_URL=http://localhost:8000

# Frontend Configuration
VITE_API_URL=http://localhost:8000
VITE_AI_URL=http://localhost:8001

# Video SDK Configuration (for streaming features)
VIDEOSDK_API_KEY=your-videosdk-api-key
VIDEOSDK_API_SECRET=your-videosdk-api-secret

# Email Configuration (for notifications)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password

# File Storage Configuration
MEDIA_ROOT=./media
STATIC_ROOT=./static

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=./logs/gymbro.log

# Security Configuration
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:80
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:80

# Development/Production Mode
ENVIRONMENT=production

# Database Reset Flag (set to true to reset database on startup)
RESET_DB=false